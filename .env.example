# Секреты приложения. НЕ коммитить в репозиторий.
# Файл читается Next.js автоматически (dotenv).

# ─── Режим источника данных ───
# mock   — данные из content/seed.json (прототип, админка /admin)
# strapi — данные из реальной CMS
CMS_PROVIDER=mock

# STRAPI_URL=http://localhost:1337
# STRAPI_TOKEN=

# ─── Токен записи в локальный редактор /admin ───
# Без него POST /api/admin запрещён. Задайте любую строку.
ADMIN_TOKEN=genorg-local-admin

# ─── Прод ───
# SITE_URL=https://genorg.ru
# LEGACY_FEED_URL=https://genorg.ru/sendfeed/
# CRM_WEBHOOK_URL=
# ALLOWED_ORIGIN=https://genorg.ru
