# Секреты приложения. НЕ коммитить в репозиторий.
# Файл читается Next.js автоматически (dotenv).

# ─── Подключение к CMS ───
# CMS — единственный источник контента и фотографий. Отдельного
# mock-режима нет: если CMS недоступна, сайт читает снимок
# content/snapshot.json (его обновляет scripts/export-snapshot.mjs).
# STRAPI_URL=http://localhost:1337
# STRAPI_TOKEN=

# Публичный адрес CMS — от него строятся ссылки на фотографии
# в вёрстке. Внутри контейнеров CMS доступна по внутреннему адресу,
# а браузеру посетителя нужен внешний.
# Локально: http://127.0.0.1:1337
# В проде:  https://cms.genorg.ru
# CMS_PUBLIC_URL=http://127.0.0.1:1337

# ─── Прод ───
# SITE_URL=https://genorg.ru
# LEGACY_FEED_URL=https://genorg.ru/sendfeed/
# CRM_WEBHOOK_URL=
# ALLOWED_ORIGIN=https://genorg.ru
# LEADS_RATE_LIMIT=5   # заявок в час с одного IP (по умолчанию 5)
