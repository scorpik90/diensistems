{
  "kind": "collectionType",
  "collectionName": "site-settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Настройки сайта",
    "description": "Глобальные данные: контакты, реквизиты, правила скидок. Одна запись."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "company": {
      "type": "string",
      "required": true
    },
    "legalName": {
      "type": "string"
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "phoneRaw": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "city": {
      "type": "string"
    },
    "foundedYear": {
      "type": "integer"
    },
    "fleetMW": {
      "type": "integer"
    },
    "deliveryHours": {
      "type": "integer"
    },
    "rating": {
      "type": "float"
    },
    "ratingCount": {
      "type": "integer"
    },
    "workingHours": {
      "type": "string"
    },
    "discountFromDays": {
      "type": "integer",
      "default": 30,
      "description": "С какого дня аренды действует скидка"
    },
    "discountPercent": {
      "type": "integer",
      "default": 10,
      "description": "Размер скидки, %"
    },
    "yandexReviewsUrl": {
      "type": "string",
      "description": "Страница отзывов на Яндекс.Картах"
    },
    "yandexOrgId": {
      "type": "string",
      "description": "ID организации на Яндекс.Картах — для виджета рейтинга"
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Полный логотип (для страницы контактов и подвала)"
    },
    "logoMark": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Знак (эмблема) — в шапке"
    },
    "heroImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "description": "Фоновая фотография первого экрана"
    },
    "footerAbout": {
      "type": "text",
      "description": "Абзац о компании в подвале"
    },
    "footerBottom": {
      "type": "text",
      "description": "Нижняя строка подвала: копирайт"
    },
    "footerContactsTitle": {
      "type": "string",
      "default": "Контакты"
    },
    "legalPolicyUrl": {
      "type": "string",
      "default": "/politika-obrabotki-personalnyh-dannyh",
      "description": "Адрес политики обработки персональных данных"
    },
    "seoTitle": {
      "type": "string",
      "description": "Заголовок главной страницы по умолчанию"
    },
    "seoDescription": {
      "type": "text",
      "description": "Описание главной страницы по умолчанию"
    },
    "ogTitle": {
      "type": "string",
      "description": "Заголовок для Open Graph"
    },
    "ogDescription": {
      "type": "text",
      "description": "Описание для Open Graph"
    }
  }
}