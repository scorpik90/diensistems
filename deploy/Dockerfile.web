# ─────────────────────────────────────────────────────────────
#  Образ сайта: Next.js 15 (App Router)
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS deps
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev --ignore-scripts=false

FROM node:22-alpine AS builder
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci --ignore-scripts
COPY . .
# generateStaticParams тянет данные из CMS, поэтому токен нужен на сборке.
# ВАЖНО: токен передаётся BuildKit secret (см. docker-compose.yml → secrets),
# а не как ARG — build args сохраняются в истории образа, secret не попадает
# ни в слои, ни в `docker history`.
ARG CMS_PROVIDER=strapi
ARG STRAPI_URL=http://strapi:1337
ARG CMS_PUBLIC_URL
ENV CMS_PROVIDER=${CMS_PROVIDER}
ENV STRAPI_URL=${STRAPI_URL}
# Ссылка на фотографии в собранной вёрстке — публичный адрес CMS
ENV CMS_PUBLIC_URL=${CMS_PUBLIC_URL}
ENV NEXT_TELEMETRY_DISABLED=1
RUN --mount=type=secret,id=strapi_token \
    STRAPI_TOKEN="$(cat /run/secrets/strapi_token 2>/dev/null || true)" npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000

# sharp не нужен: images.unoptimized=true, next/image отдаёт <picture>
# без ресайза на сервере
RUN apk add --no-cache libc6-compat && \
    addgroup -g 1001 -S nodejs && \
    adduser -S nextjs -u 1001

COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.mjs ./next.config.mjs

USER nextjs
EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start", "-p", "3000"]
