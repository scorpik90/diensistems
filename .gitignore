# ─── Секреты и локальное окружение ───────────────────────────────
.env
.env.local
.env.production
.strapi-tokens.json
# Секрет сборки образа (BuildKit) — создаёт deploy.sh из .env
secrets/
# Секрет сборки сайта (BuildKit secret, создаётся deploy.sh)
secrets/

# ─── Данные приложения, которые не должны попасть в репозиторий ──
# Заявки с формы (резервный канал, когда CMS недоступна)
data/
# Скопированные файлы боевого сайта при миграции
scripts/_cache/
# Кэш краулера в корне проекта (снимки html) — не коммитим
_cache/

# ВНИМАНИЕ: assets/legacy-images/ коммитится намеренно.
# Это архив исходных фотографий боевого сайта — источник для
# перезаливки в медиатеку Strapi (scripts/import-content-to-cms.mjs).
# Сайт эти файлы не раздаёт: все снимки отдаёт CMS.

# ─── Сборка ─────────────────────────────────────────────────────
.next/
out/
build/
dist/
tsconfig.tsbuildinfo

# ─── Зависимости ────────────────────────────────────────────────
node_modules/
cms-admin/node_modules/
cms-admin/dist/
cms-admin/.cache/
cms-admin/.tmp/
cms-admin/build/
cms-admin/public/uploads/

# ─── Логи и временное ──────────────────────────────────────────
*.log
*.err
tmp-legacy/
tmp-*.html
.DS_Store
Thumbs.db
